# ローカル開発用。.env にコピーして使う（本物の.envはコミットしないこと）。

PORT=8080

# SupabaseのPostgres接続文字列。
# 直接接続（ローカル開発・低同時実行数向け）:
#   postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# プーラー経由接続（Cloud Runデプロイ後、トランザクションモード推奨）:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# 本プロジェクトのproject ref: ktmnkhfhzevytocbccka
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.ktmnkhfhzevytocbccka.supabase.co:5432/postgres

# --- M1（認証） ---
# JWT_SECRET, GOOGLE_OAUTH_CLIENT_ID/SECRET, GOOGLE_OAUTH_REDIRECT_URL, FRONTEND_URLは必須
# （config.Load()が起動時にチェックする）。GoogleのOAuthクライアントはGCPコンソールで
# 作成し、承認済みリダイレクトURIにGOOGLE_OAUTH_REDIRECT_URLと同じ値を登録すること。
JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# --- M4（添付ファイル）で追加 ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# --- M3（リアルタイムチャット）で追加 ---
# SUPABASE_URL=https://ktmnkhfhzevytocbccka.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
