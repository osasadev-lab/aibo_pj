# Copy to .env for local development. Never commit the real .env file.

PORT=8080

# Supabase Postgres connection string.
# Direct connection (fine for local dev / low concurrency):
#   postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# Pooler connection (recommended once deployed to Cloud Run, transaction mode):
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# Project ref for this project: ktmnkhfhzevytocbccka
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.ktmnkhfhzevytocbccka.supabase.co:5432/postgres

