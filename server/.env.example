# ローカル開発用。.env にコピーして使う（本物の.envはコミットしないこと）。

PORT=8080

# SupabaseのPostgres接続文字列。
# 直接接続（ローカル開発・低同時実行数向け）:
#   postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# プーラー経由接続（Cloud Runデプロイ後、トランザクションモード推奨）:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# 本プロジェクトのproject ref: ktmnkhfhzevytocbccka
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.ktmnkhfhzevytocbccka.supabase.co:5432/postgres

# --- M1（認証） ---
# JWT_SECRET, GOOGLE_OAUTH_CLIENT_ID/SECRET, GOOGLE_OAUTH_REDIRECT_URL, FRONTEND_URLは必須
# （config.Load()が起動時にチェックする）。GoogleのOAuthクライアントはGCPコンソールで
# 作成し、承認済みリダイレクトURIにGOOGLE_OAUTH_REDIRECT_URLと同じ値を登録すること。
JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# --- M3（リアルタイムチャット） ---
# SupabaseダッシュボードのSettings > API > 「JWT Secret」からコピーする。
# このアプリ自身のJWT_SECRETとは別物（Supabase Realtime/PostgRESTのRLSが読む
# auth.uid()を解決するための署名鍵）。必須（config.Load()が起動時にチェックする）。
SUPABASE_JWT_SECRET=

# --- M4（添付ファイル）で追加 ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# --- M6（Googleカレンダー連携）で追加 ---
# GOOGLE_CALENDAR_REDIRECT_URLとTOKEN_ENCRYPTION_KEYは必須（config.Load()が起動時にチェックする）。
# GOOGLE_CALENDAR_REDIRECT_URLはログイン用GOOGLE_OAUTH_REDIRECT_URLとは別のcallback。
# GCPコンソールの承認済みリダイレクトURIにこちらも追加登録し、OAuth同意画面に
# https://www.googleapis.com/auth/calendar.events スコープを追加しておくこと。
GOOGLE_CALENDAR_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/calendar/callback
# users.google_refresh_tokenの暗号化用（AES-256-GCM）。base64エンコードされた32バイト。
# `openssl rand -base64 32`等で生成する。
TOKEN_ENCRYPTION_KEY=

# --- M7（通知・検索）で追加 ---
# VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEYはWeb Push配信用の鍵ペア。webpush-goの
# webpush.GenerateVAPIDKeys()で1回生成する（`go run`で小さなヘルパーを書いて実行するか、
# 他言語のVAPID鍵生成ツールでも可）。VAPID_SUBJECTは"mailto:"連絡先メール、またはhttps URL。
# いずれもconfig.Load()が起動時にチェックする必須項目。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:osasadev@gmail.com
# Cloud Schedulerからの内部cronエンドポイント（POST /internal/cron/reminders）を
# 認証する共有シークレット。`openssl rand -base64 32`等で生成する。必須。
INTERNAL_CRON_SECRET=
